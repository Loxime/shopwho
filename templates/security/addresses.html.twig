{% extends 'profile/dashboard_layout.html.twig' %}

{% block title %}
  Mes adresses — Shopwho
{% endblock %}

{% block profile_content %}
  <section
    class="profile-dashboard-card"
    aria-labelledby="profile-addresses-title"
  >
    <div class="profile-dashboard-card-heading">
      <div>
        <p class="profile-dashboard-card-eyebrow">
          Livraison et facturation
        </p>

        <h2 id="profile-addresses-title">
          Mes adresses
        </h2>

        <p class="muted">
          Gérez vos informations de livraison et
          de facturation.
        </p>
      </div>

      <i
        class="fa-solid fa-location-dot"
        aria-hidden="true"
      ></i>
    </div>

    <div class="address-data-notice">
      <i
        class="fa-solid fa-circle-info"
        aria-hidden="true"
      ></i>

      <div>
        <strong>
          Utilisation des données géographiques
        </strong>

        <p>
          La ville, le code postal et le pays pourront
          être utilisés dans les analyses statistiques
          du projet Shopwho.
        </p>

        <p class="muted">
          Les lignes détaillées de votre adresse
          ne sont pas destinées aux analyses.
        </p>
      </div>
    </div>
  </section>

  <div class="address-grid profile-dashboard-address-grid">
    <article class="address-card">
      <div class="address-card-heading">
        <i
          class="fa-solid fa-truck"
          aria-hidden="true"
        ></i>

        <div>
          <h2>Adresse de livraison</h2>

          <p class="muted">
            Adresse utilisée pour simuler
            la livraison.
          </p>
        </div>
      </div>

      {{ form_start(shippingForm, {
        attr: {
          'data-address-autocomplete': '',
          'data-address-lookup-url': path(
            'app_profile_address_autocomplete'
          )
        }
      }) }}

        {{ form_errors(shippingForm) }}

        {% for field in [
          shippingForm.firstName,
          shippingForm.lastName,
          shippingForm.line1,
          shippingForm.line2
        ] %}
          <div class="form-row">
            {{ form_label(field) }}
            {{ form_widget(field) }}
            {{ form_errors(field) }}
          </div>
        {% endfor %}

        <div class="address-city-row">
          <div class="form-row">
            {{ form_label(shippingForm.postalCode) }}
            {{ form_widget(shippingForm.postalCode) }}
            {{ form_errors(shippingForm.postalCode) }}
          </div>

          <div class="form-row">
            {{ form_label(shippingForm.city) }}
            {{ form_widget(shippingForm.city) }}
            {{ form_errors(shippingForm.city) }}
          </div>
        </div>

        <div
          class="address-autocomplete-feedback"
          data-address-feedback
          aria-live="polite"
        ></div>

        <div
          class="address-suggestions"
          data-address-suggestions
          role="listbox"
          hidden
        ></div>

        <div class="form-row">
          {{ form_label(shippingForm.countryCode) }}
          {{ form_widget(shippingForm.countryCode) }}
          {{ form_errors(shippingForm.countryCode) }}
        </div>

        <label class="address-copy-option">
          <input
            type="checkbox"
            name="copy_shipping_to_billing"
            value="1"
          >

          <span>
            Utiliser également cette adresse
            pour la facturation
          </span>
        </label>

        <button
          class="btn orange"
          type="submit"
        >
          Enregistrer l’adresse de livraison
        </button>

      {{ form_end(shippingForm) }}
    </article>

    <article class="address-card">
      <div class="address-card-heading">
        <i
          class="fa-solid fa-file-invoice"
          aria-hidden="true"
        ></i>

        <div>
          <h2>Adresse de facturation</h2>

          <p class="muted">
            Adresse utilisée pour simuler
            la facturation.
          </p>
        </div>
      </div>

      {{ form_start(billingForm, {
        attr: {
          'data-address-autocomplete': '',
          'data-address-lookup-url': path(
            'app_profile_address_autocomplete'
          )
        }
      }) }}

        {{ form_errors(billingForm) }}

        {% for field in [
          billingForm.firstName,
          billingForm.lastName,
          billingForm.line1,
          billingForm.line2
        ] %}
          <div class="form-row">
            {{ form_label(field) }}
            {{ form_widget(field) }}
            {{ form_errors(field) }}
          </div>
        {% endfor %}

        <div class="address-city-row">
          <div class="form-row">
            {{ form_label(billingForm.postalCode) }}
            {{ form_widget(billingForm.postalCode) }}
            {{ form_errors(billingForm.postalCode) }}
          </div>

          <div class="form-row">
            {{ form_label(billingForm.city) }}
            {{ form_widget(billingForm.city) }}
            {{ form_errors(billingForm.city) }}
          </div>
        </div>

        <div
          class="address-autocomplete-feedback"
          data-address-feedback
          aria-live="polite"
        ></div>

        <div
          class="address-suggestions"
          data-address-suggestions
          role="listbox"
          hidden
        ></div>

        <div class="form-row">
          {{ form_label(billingForm.countryCode) }}
          {{ form_widget(billingForm.countryCode) }}
          {{ form_errors(billingForm.countryCode) }}
        </div>

        <button
          class="btn orange"
          type="submit"
        >
          Enregistrer l’adresse de facturation
        </button>

      {{ form_end(billingForm) }}
    </article>
  </div>
{% endblock %}
