{% extends 'profile/dashboard_layout.html.twig' %}

{% block title %}
  Commande {{ order.reference }} — Shopwho
{% endblock %}

{% block profile_content %}
  <section
    class="profile-dashboard-card"
    aria-labelledby="order-detail-title"
  >
    <div class="profile-dashboard-card-heading">
      <div>
        <p class="profile-dashboard-card-eyebrow">
          Détail de commande
        </p>

        <h1 id="order-detail-title">
          {{ order.reference }}
        </h1>

        <p class="muted">
          {{ order.orderedAt|date('d/m/Y H:i') }}
          · {{ order.statusLabel }}
        </p>
      </div>

      <i
        class="fa-solid fa-box-open"
        aria-hidden="true"
      ></i>
    </div>

    <table class="table">
      <thead>
        <tr>
          <th>Produit</th>
          <th>Quantité</th>
          <th>Prix</th>
        </tr>
      </thead>

      <tbody>
        {% for item in order.items %}
          <tr>
            <td>{{ item.productNameSnapshot }}</td>
            <td>{{ item.quantity }}</td>
            <td>
              {{ (item.unitPriceCents / 100)
                |number_format(2, ',', ' ')
              }}
              €
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="profile-dashboard-card-actions">
      <a
        class="btn"
        href="{{ path('app_profile_orders') }}"
        data-profile-dashboard-link
        data-profile-section="orders"
      >
        <i
          class="fa-solid fa-arrow-left"
          aria-hidden="true"
        ></i>

        Retour aux commandes
      </a>
    </div>
  </section>
{% endblock %}
