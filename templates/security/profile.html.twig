{% extends 'base.html.twig' %}

{% block title %}Mon profil — Shopwho{% endblock %}

{% block body %}
<section class="section"><div class="container profile-page">
  <div class="profile-heading"><i class="fa-solid fa-circle-user" aria-hidden="true"></i><div><h1>Mon profil</h1><p class="muted">Les informations de votre compte Shopwho.</p></div></div>
  <dl class="profile-details">
    <div><dt>Prénom</dt><dd>{{ user.firstName ?? 'Non renseigné' }}</dd></div>
    <div><dt>Nom</dt><dd>{{ user.lastName ?? 'Non renseigné' }}</dd></div>
    <div><dt>Adresse e-mail</dt><dd>{{ user.email }}</dd></div>
    <div><dt>Compte créé le</dt><dd>{{ user.createdAt|date('d/m/Y') }}</dd></div>
  </dl>
  <section class="section" aria-labelledby="recent-orders-title">
    <h2 id="recent-orders-title">Mes commandes récentes</h2>
    {% if orders is empty %}
      <p class="muted">Vous n’avez pas encore de commande enregistrée.</p>
    {% else %}
      <div class="order-list">
        {% for order in orders %}
          <article class="order-summary">
            <h3><a href="{{ path('app_profile_order_show', {reference: order.reference}) }}">{{ order.reference }}</a></h3>
            <p>{{ order.orderedAt|date('d/m/Y H:i') }} · {{ order.status }} · {{ (order.totalCents / 100)|number_format(2, ',', ' ') }} € · {{ order.itemCount }} article{% if order.itemCount > 1 %}s{% endif %}</p>
          </article>
        {% endfor %}
      </div>
    {% endif %}
    <a class="btn" href="{{ path('app_profile_orders') }}">Voir toutes mes commandes</a>
  </section>
</div></section>
{% endblock %}
