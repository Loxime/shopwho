<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Shopwho{% endblock %}</title>
  <link rel="stylesheet" href="/styles/app.css">
</head>
<body>
<header class="site-header">
  <div class="promo">Livraison offerte dès 59 € en France</div>
  <div class="header-main container">
    <a class="brand" href="{{ path('app_home') }}">SHOPWHO</a>
    <form class="search" action="{{ path('app_home') }}" method="get">
      <input type="search" name="q" value="{{ app.request.query.get('q') }}" placeholder="Rechercher un produit...">
    </form>
    <nav>
      <a href="{{ path('app_cart') }}">Panier</a>
      <a href="{{ path('admin_product_index') }}">Admin</a>
    </nav>
  </div>
</header>
<main>{% block body %}{% endblock %}</main>
<footer class="footer"><div class="container">Shopwho — MVP e-commerce instrumenté pour la data science.</div></footer>
{% if app.request.cookies.get('shopwho_tracking_consent') is null %}
<div style="position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid #d1d5db;padding:16px;z-index:20;box-shadow:0 -6px 20px rgba(0,0,0,.08)">
  <div class="container" style="display:flex;gap:20px;justify-content:space-between;align-items:center;flex-wrap:wrap">
    <div><strong>Mesure d'audience Shopwho</strong><div class="muted">Vous pouvez accepter ou refuser la collecte d'événements de navigation pseudonymisés utilisés pour le projet de data science.</div></div>
    <div class="actions">
      <form method="post" action="{{ path('app_tracking_consent', {choice:'refuse'}) }}"><button type="submit">Refuser</button></form>
      <form method="post" action="{{ path('app_tracking_consent', {choice:'accept'}) }}"><button class="btn orange" type="submit">Accepter</button></form>
    </div>
  </div>
</div>
{% endif %}
</body>
</html>
