<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Shopwho{% endblock %}</title>
  <link rel="stylesheet" href="/styles/app.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer">
</head>
<body>
<header class="site-header">
  <div class="promo">Livraison offerte dès 59 € en France</div>
  <div class="header-main container">
    <a class="brand" href="{{ path('app_home') }}">SHOPWHO</a>
    <form class="search" action="{{ path('app_home') }}" method="get">
      <label class="sr-only" for="header-search">Rechercher un produit</label>
      <input id="header-search" type="search" name="q" value="{{ app.request.query.get('q') }}" placeholder="Rechercher un produit...">
      <button type="submit" title="Rechercher" aria-label="Rechercher"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
    </form>
    <nav aria-label="Actions utilisateur">
      <a class="header-action" href="{{ path('app_cart') }}" title="Panier" aria-label="Panier"><i class="fa-solid fa-cart-shopping" aria-hidden="true"></i></a>
      {% if app.user %}
         <details class="profile-menu"><summary class="header-action" title="Profil" aria-label="Ouvrir le menu profil"><i class="fa-solid fa-user" aria-hidden="true"></i></summary><div class="profile-dropdown">
           <span class="profile-email">{{ app.user.displayName }}</span>
           <a href="{{ path('app_profile') }}"><i class="fa-solid fa-id-card" aria-hidden="true"></i> Mon profil</a>
           <a href="{{ path('app_profile_orders') }}"><i class="fa-solid fa-box" aria-hidden="true"></i> Mes commandes</a>
           {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin_product_index') }}"><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i> Se rendre sur le backoffice</a>{% endif %}
           <a href="{{ path('app_logout') }}"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> Déconnexion</a>
         </div></details>
      {% else %}
        <a class="header-action" href="{{ path('app_login') }}" title="Connexion" aria-label="Connexion"><i class="fa-solid fa-user" aria-hidden="true"></i></a>
      {% endif %}
    </nav>
  </div>
  {% set navigationCategories = shopwho_navigation_categories() %}
  {% set allCategories = shopwho_all_categories() %}
  {% set featuredCategories = shopwho_featured_categories() %}
  {% if allCategories is not empty %}<nav class="category-bar" aria-label="Catégories de produits"><div class="container category-links">
    <details class="all-categories"><summary><i class="fa-solid fa-bars" aria-hidden="true"></i> Toutes</summary><div class="category-panel">
      <div><strong>Toutes les catégories</strong>{% for item in allCategories %}<a href="{{ path('app_home', {category:item.slug}) }}">{% if item.icon %}<i class="{{ item.icon }}" aria-hidden="true"></i>{% endif %} {{ item.name }}</a>{% endfor %}<a href="{{ path('app_home') }}">Voir tout</a></div>
      {% if featuredCategories is not empty %}<div><strong>À la une</strong>{% for item in featuredCategories %}<a href="{{ path('app_home', {category:item.slug}) }}">{{ item.name }}</a>{% endfor %}</div>{% endif %}
    </div></details>
    {% for item in navigationCategories %}<a href="{{ path('app_home', {category:item.slug}) }}">{% if item.icon %}<i class="{{ item.icon }}" aria-hidden="true"></i>{% endif %} {{ item.name }}</a>{% endfor %}
  </div></nav>{% endif %}
</header>
<main>{% block body %}{% endblock %}</main>
<footer class="footer"><div class="container">Shopwho — MVP e-commerce instrumenté pour la data science.</div></footer>
{% if app.request.cookies.get('shopwho_tracking_consent') is null %}
<div style="position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid #d1d5db;padding:16px;z-index:20;box-shadow:0 -6px 20px rgba(0,0,0,.08)">
  <div class="container" style="display:flex;gap:20px;justify-content:space-between;align-items:center;flex-wrap:wrap">
    <div><strong>Mesure d'audience Shopwho</strong><div class="muted">Vous pouvez accepter ou refuser la collecte d'événements de navigation utilisés pour le projet de data science. Si vous êtes connecté, ces événements peuvent être associés à votre compte Shopwho.</div></div>
    <div class="actions">
      <form method="post" action="{{ path('app_tracking_consent', {choice:'refuse'}) }}"><button type="submit">Refuser</button></form>
      <form method="post" action="{{ path('app_tracking_consent', {choice:'accept'}) }}"><button class="btn orange" type="submit">Accepter</button></form>
    </div>
  </div>
</div>
{% endif %}
</body>
</html>
