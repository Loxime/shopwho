{% extends 'base.html.twig' %}

{% set catalogTrackingEnabled =
  app.request.cookies.get('shopwho_tracking_consent') == 'yes'
%}

{% block title %}Shopwho — découvrir{% endblock %}

{% block meta_description %}
Découvrez Shopwho, un catalogue e-commerce expérimental conçu pour étudier les parcours utilisateurs, les recommandations et les interactions avec les produits.
{% endblock %}

{% block canonical_url -%}
{{ app.request.schemeAndHttpHost ~ path(
  'app_home',
  category
    ? {
        category: category
      }
    : {}
) }}
{%- endblock %}

{% block meta_robots %}
{{ query
  or hasCatalogFilters
  or sort != 'newest'
    ? 'noindex,follow'
    : 'index,follow,max-image-preview:large'
}}
{% endblock %}

{% block body %}
  <section class="hero home-hero">
    <div class="container hero-grid home-hero-grid">
      <div class="home-hero-content">
        <p class="home-hero-eyebrow">
          E-commerce expérimental & data
        </p>

        <h1>
          Découvrez ce qui vous ressemble.
        </h1>

        <p class="home-hero-description">
          Explorez un catalogue e-commerce conçu
          comme un environnement d’expérimentation
          autour des parcours utilisateurs, des
          recommandations et de la donnée.
        </p>

        <div class="home-hero-actions">
          <a
            class="btn orange"
            href="#catalogue"
          >
            Voir les produits

            <i
              class="fa-solid fa-arrow-down"
              aria-hidden="true"
            ></i>
          </a>

          {% if specialOffers is not empty %}
            <a
              class="home-hero-secondary-link"
              href="#special-offers"
            >
              Voir les offres du moment

              <i
                class="fa-solid fa-arrow-right"
                aria-hidden="true"
              ></i>
            </a>
          {% endif %}
        </div>

        <div class="home-hero-reassurance">
          <span>
            <i
              class="fa-solid fa-flask"
              aria-hidden="true"
            ></i>
            Projet expérimental
          </span>

          <span>
            <i
              class="fa-solid fa-lock"
              aria-hidden="true"
            ></i>
            Données pseudonymisées
          </span>

          <span>
            <i
              class="fa-solid fa-credit-card"
              aria-hidden="true"
            ></i>
            Aucun paiement réel
          </span>
        </div>
      </div>

      <aside
        class="home-hero-panel"
        aria-label="Présentation de Shopwho"
      >
        <div class="home-hero-panel-brand">
          <span>
            SHOP
          </span>

          <strong>
            WHO?
          </strong>
        </div>

        <p>
          Une boutique conçue pour comprendre
          comment un parcours, une offre ou une
          recommandation influence la découverte
          d’un produit.
        </p>

        <div class="home-hero-features">
          <div>
            <span class="home-hero-feature-icon">
              <i
                class="fa-solid fa-bag-shopping"
                aria-hidden="true"
              ></i>
            </span>

            <div>
              <strong>
                Catalogue
              </strong>

              <span>
                Rechercher, filtrer et comparer.
              </span>
            </div>
          </div>

          <div>
            <span class="home-hero-feature-icon">
              <i
                class="fa-solid fa-wand-magic-sparkles"
                aria-hidden="true"
              ></i>
            </span>

            <div>
              <strong>
                Recommandations
              </strong>

              <span>
                Des sélections adaptées au contexte.
              </span>
            </div>
          </div>

          <div>
            <span class="home-hero-feature-icon">
              <i
                class="fa-solid fa-chart-line"
                aria-hidden="true"
              ></i>
            </span>

            <div>
              <strong>
                Expérimentation
              </strong>

              <span>
                Mesurer les interactions du parcours.
              </span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {% if specialOffers is not empty %}
    <section
      id="special-offers"
      class="section special-offers-section home-offers-section"
      aria-labelledby="special-offers-title"
    >
      <div class="container">
        <header class="special-offers-heading home-section-heading">
          <div>
            <p class="special-offers-eyebrow">
              En ce moment
            </p>

            <h2 id="special-offers-title">
              Nos offres spéciales
            </h2>

            <p class="muted">
              Des sélections mises en avant pour
              expérimenter différents parcours de
              découverte sur Shopwho.
            </p>
          </div>

          <div
            class="home-section-heading-icon"
            aria-hidden="true"
          >
            <i class="fa-solid fa-bolt"></i>
          </div>
        </header>

        {% set primaryOffers =
          specialOffers|slice(0, 3)
        %}

        {% set secondaryOffers =
          specialOffers|slice(3, 5)
        %}

        <div class="special-offers-primary">
          {% for offer in primaryOffers %}
            {% set offerUrl =
              offer.targetUrl
                ?? (
                  offer.targetCategory
                    ? path(
                        'app_home',
                        {
                          category:
                            offer.targetCategory.slug
                        }
                      )
                    : null
                )
            %}

            <article
              class="
                special-offer-card
                special-offer-card-primary
                js-special-offer
              "
              data-special-offer
              data-offer-id="{{ offer.id }}"
              data-placement="homepage"
              data-position="{{ loop.index }}"
              data-tracking-endpoint="{{ path(
                'app_tracking_special_offers'
              ) }}"
              data-tracking-token="{{ csrf_token(
                'special_offer_tracking'
              ) }}"
              style="
                --offer-bg: {{ offer.backgroundColor }};
                --offer-text: {{ offer.textColor }};
              "
            >
              <div class="special-offer-card-decoration">
                <i
                  class="fa-solid fa-tag"
                  aria-hidden="true"
                ></i>
              </div>

              <div class="special-offer-card-content">
                <div class="special-offer-card-topline">
                  <span>
                    Offre {{ loop.index }}
                  </span>

                  {% if offer.targetCategory %}
                    <span class="special-offer-category">
                      {{ offer.targetCategory.name }}
                    </span>
                  {% endif %}
                </div>

                <h3>
                  {{ offer.title }}
                </h3>

                <p>
                  {{ offer.content }}
                </p>

                {% if offerUrl %}
                  <a
                    class="
                      special-offer-cta
                      js-special-offer-link
                    "
                    href="{{ offerUrl }}"
                  >
                    {{ offer.ctaLabel ?? 'Découvrir' }}

                    <i
                      class="fa-solid fa-arrow-right"
                      aria-hidden="true"
                    ></i>
                  </a>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>

        {% if secondaryOffers is not empty %}
          <div class="special-offers-secondary">
            {% for offer in secondaryOffers %}
              {% set offerUrl =
                offer.targetUrl
                  ?? (
                    offer.targetCategory
                      ? path(
                          'app_home',
                          {
                            category:
                              offer.targetCategory.slug
                          }
                        )
                      : null
                  )
              %}

              <article
                class="
                  special-offer-card
                  special-offer-card-secondary
                  js-special-offer
                "
                data-special-offer
                data-offer-id="{{ offer.id }}"
                data-placement="homepage"
                data-position="{{ loop.index + 3 }}"
                data-tracking-endpoint="{{ path(
                  'app_tracking_special_offers'
                ) }}"
                data-tracking-token="{{ csrf_token(
                  'special_offer_tracking'
                ) }}"
                style="
                  --offer-bg: {{ offer.backgroundColor }};
                  --offer-text: {{ offer.textColor }};
                "
              >
                <div class="special-offer-card-content">
                  <div class="special-offer-card-topline">
                    <span>
                      Sélection
                    </span>

                    {% if offer.targetCategory %}
                      <span class="special-offer-category">
                        {{ offer.targetCategory.name }}
                      </span>
                    {% endif %}
                  </div>

                  <h3>
                    {{ offer.title }}
                  </h3>

                  <p>
                    {{ offer.content }}
                  </p>

                  {% if offerUrl %}
                    <a
                      class="
                        special-offer-cta
                        js-special-offer-link
                      "
                      href="{{ offerUrl }}"
                    >
                      {{ offer.ctaLabel ?? 'Découvrir' }}

                      <i
                        class="fa-solid fa-arrow-right"
                        aria-hidden="true"
                      ></i>
                    </a>
                  {% endif %}
                </div>
              </article>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>
  {% endif %}

  {% if recommendations is not empty %}
    {% set primaryRecommendationStrategy =
      recommendations|first.strategy
    %}

    <section
      class="section recommendations-section home-showcase-section"
      aria-labelledby="recommendations-title"
      {% if catalogTrackingEnabled %}
        data-recommendation-tracking
        data-tracking-endpoint="{{ path(
          'app_tracking_recommendations'
        ) }}"
        data-tracking-token="{{ csrf_token(
          'recommendation_tracking'
        ) }}"
      {% endif %}
    >
      <div class="container">
        <div class="recommendations-heading">
          <div>
            {% if primaryRecommendationStrategy
              == 'frequently_viewed'
            %}
              <p class="recommendations-eyebrow">
                Sélection personnalisée
              </p>

              <h2 id="recommendations-title">
                Pour vous
              </h2>

              <p class="muted">
                Une sélection basée sur les produits
                que vous avez consultés récemment.
              </p>
            {% elseif primaryRecommendationStrategy
              == 'popular_30d'
            %}
              <p class="recommendations-eyebrow">
                Les tendances du moment
              </p>

              <h2 id="recommendations-title">
                Les plus populaires
              </h2>

              <p class="muted">
                Les produits les plus commandés
                récemment sur Shopwho.
              </p>
            {% else %}
              <p class="recommendations-eyebrow">
                Les mieux notés
              </p>

              <h2 id="recommendations-title">
                Les favoris de nos clients
              </h2>

              <p class="muted">
                Une sélection des produits les
                mieux évalués.
              </p>
            {% endif %}
          </div>
        </div>

        <div class="grid recommendations-grid home-product-grid">
          {% for recommendation in recommendations %}
            {% set product =
              recommendation.product
            %}

            {% set rating =
              productRatingStats[product.id] ?? null
            %}

            <article
              class="
                card
                recommendation-card
                js-recommendation-card
              "
              data-product-id="{{ product.id }}"
              data-position="{{ loop.index }}"
              data-strategy="{{ recommendation.strategy }}"
            >
              <a
                class="js-recommendation-link"
                href="{{ path(
                  'app_product_show',
                  {
                    slug: product.slug
                  }
                ) }}"
              >
                {% if product.imageUrl %}
                  <img
                    src="{{ product.imageUrl }}"
                    alt="{{ product.name }}"
                  >
                {% else %}
                  <div
                    class="product-image-placeholder"
                    aria-hidden="true"
                  >
                    🛍️
                  </div>
                {% endif %}

                <div class="card-body">
                  <div class="muted">
                    {{ product.category.name }}
                  </div>

                  <h3>
                    {{ product.name }}
                  </h3>

                  {% if rating and rating.count > 0 %}
                    {% set roundedRating =
                      rating.average|round
                    %}

                    <div
                      class="card-rating"
                      aria-label="
                        Note moyenne
                        {{ rating.average|number_format(
                          1,
                          ',',
                          ' '
                        ) }}
                        sur 5,
                        {{ rating.count }}
                        avis
                      "
                    >
                      <span
                        class="stars"
                        aria-hidden="true"
                      >
                        {% for star in 1..5 %}
                          {{ star <= roundedRating
                            ? '★'
                            : '☆'
                          }}
                        {% endfor %}
                      </span>

                      <span>
                        {{ rating.average|number_format(
                          1,
                          ',',
                          ' '
                        ) }}
                        ({{ rating.count }})
                      </span>
                    </div>
                  {% else %}
                    <div class="card-rating muted">
                      Pas encore d’avis
                    </div>
                  {% endif %}

                  <p class="card-description">
                    {{ product.description|slice(0, 60) }}
                    {%- if product.description|length > 60 -%}
                      …
                    {%- endif -%}
                  </p>

                  <div class="price">
                    {{ product.price|number_format(
                      2,
                      ',',
                      ' '
                    ) }}
                    €
                  </div>
                </div>
              </a>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  <section
    id="catalogue"
    class="section catalog-section home-showcase-section"
    {% if catalogTrackingEnabled %}
      data-catalog-tracking
      data-tracking-endpoint="{{ path('app_tracking_catalog') }}"
      data-tracking-token="{{ csrf_token('catalog_tracking') }}"
      data-query="{{ query ?? '' }}"
      data-category="{{ category ?? '' }}"
    {% endif %}
  >
    <div class="container">
      <div class="actions catalog-heading">
        <div>
          <p class="catalog-heading-eyebrow">
            Explorer Shopwho
          </p>

          <h2>Nos produits</h2>

          <p class="muted">
            Recherchez, filtrez et triez le catalogue
            selon vos préférences.
          </p>
        </div>

        <div class="actions category-filter">
          <a
            href="{{ path('app_home') }}"
            {% if not category %}
              aria-current="page"
            {% endif %}
          >
            Tous
          </a>

          {% for item in categories %}
            <a
              href="{{ path(
                'app_home',
                {
                  category: item.slug
                }
              ) }}"
              {% if category == item.slug %}
                aria-current="page"
              {% endif %}
            >
              {{ item.name }}
            </a>
          {% endfor %}
        </div>
      </div>

      {% set filterResetParams = {
        sort: sort
      } %}

      {% if query %}
        {% set filterResetParams =
          filterResetParams|merge({
            q: query
          })
        %}
      {% endif %}

      {% if category %}
        {% set filterResetParams =
          filterResetParams|merge({
            category: category
          })
        %}
      {% endif %}

      <div class="catalog-toolbar home-catalog-toolbar">
        <form
          class="catalog-controls"
          action="{{ path('app_home') }}"
          method="get"
        >
          {% if query %}
            <input
              type="hidden"
              name="q"
              value="{{ query }}"
            >
          {% endif %}

          {% if category %}
            <input
              type="hidden"
              name="category"
              value="{{ category }}"
            >
          {% endif %}

          <div class="catalog-control">
            <label for="catalog-sort">
              Trier par
            </label>

            <select
              id="catalog-sort"
              name="sort"
            >
              <option
                value="newest"
                {% if sort == 'newest' %}
                  selected
                {% endif %}
              >
                Nouveautés
              </option>

              <option
                value="price_asc"
                {% if sort == 'price_asc' %}
                  selected
                {% endif %}
              >
                Prix croissant
              </option>

              <option
                value="price_desc"
                {% if sort == 'price_desc' %}
                  selected
                {% endif %}
              >
                Prix décroissant
              </option>

              <option
                value="name_asc"
                {% if sort == 'name_asc' %}
                  selected
                {% endif %}
              >
                Nom A → Z
              </option>
            </select>
          </div>

          <div class="catalog-control">
            <label for="catalog-min-price">
              Prix minimum
            </label>

            <input
              id="catalog-min-price"
              type="number"
              name="min_price"
              min="0"
              step="0.01"
              inputmode="decimal"
              value="{% if minPriceCents is not null %}{{ minPriceCents / 100 }}{% endif %}"
              placeholder="0,00 €"
            >
          </div>

          <div class="catalog-control">
            <label for="catalog-max-price">
              Prix maximum
            </label>

            <input
              id="catalog-max-price"
              type="number"
              name="max_price"
              min="0"
              step="0.01"
              inputmode="decimal"
              value="{% if maxPriceCents is not null %}{{ maxPriceCents / 100 }}{% endif %}"
              placeholder="100,00 €"
            >
          </div>

          <label class="catalog-stock-filter">
            <input
              type="checkbox"
              name="in_stock"
              value="1"
              {% if inStockOnly %}
                checked
              {% endif %}
            >

            <span>
              En stock uniquement
            </span>
          </label>

          <button
            class="btn"
            type="submit"
          >
            Appliquer
          </button>

          {% if hasCatalogFilters %}
            <a
              class="catalog-filter-reset"
              href="{{ path(
                'app_home',
                filterResetParams
              ) }}"
            >
              Réinitialiser les filtres
            </a>
          {% endif %}
        </form>
      </div>

      {% if query %}
        <p>
          Résultats pour
          <strong>{{ query }}</strong>
        </p>
      {% endif %}

      <div class="grid catalog-grid home-product-grid">
        {% for product in products %}
          {% set rating =
            productRatingStats[product.id] ?? null
          %}

          <article
            class="card js-product-card"
            data-product-id="{{ product.id }}"
            data-position="{{ loop.index }}"
          >
            <a
              class="js-product-card-link"
              href="{{ path(
                'app_product_show',
                {
                  slug: product.slug
                }
              ) }}"
            >
              {% if product.imageUrl %}
                <img
                  src="{{ product.imageUrl }}"
                  alt="{{ product.name }}"
                >
              {% else %}
                <div
                  class="product-image-placeholder"
                  aria-hidden="true"
                >
                  🛍️
                </div>
              {% endif %}

              <div class="card-body">
                <div class="muted">
                  {{ product.category.name }}
                </div>

                <h3>
                  {{ product.name }}
                </h3>

                {% if rating and rating.count > 0 %}
                  {% set roundedRating =
                    rating.average|round
                  %}

                  <div
                    class="card-rating"
                    aria-label="
                      Note moyenne
                      {{ rating.average|number_format(
                        1,
                        ',',
                        ' '
                      ) }}
                      sur 5,
                      {{ rating.count }}
                      avis
                    "
                  >
                    <span
                      class="stars"
                      aria-hidden="true"
                    >
                      {% for star in 1..5 %}
                        {{ star <= roundedRating
                          ? '★'
                          : '☆'
                        }}
                      {% endfor %}
                    </span>

                    <span>
                      {{ rating.average|number_format(
                        1,
                        ',',
                        ' '
                      ) }}
                      ({{ rating.count }})
                    </span>
                  </div>
                {% else %}
                  <div class="card-rating muted">
                    Pas encore d’avis
                  </div>
                {% endif %}

                <p class="card-description">
                  {{ product.description|slice(0, 60) }}
                  {%- if product.description|length > 60 -%}
                    …
                  {%- endif -%}
                </p>

                <div class="price">
                  {{ product.price|number_format(
                    2,
                    ',',
                    ' '
                  ) }}
                  €
                </div>
              </div>
            </a>
          </article>
        {% else %}
          <div
            class="catalog-empty-state"
            role="status"
          >
            <i
              class="fa-solid fa-magnifying-glass"
              aria-hidden="true"
            ></i>

            {% if query %}
              <h3>
                Aucun résultat pour « {{ query }} »
              </h3>

              <p class="muted">
                Aucun produit du catalogue ne correspond
                actuellement à cette recherche.
              </p>
            {% elseif category %}
              <h3>
                Aucun produit dans cette catégorie
              </h3>

              <p class="muted">
                Aucun produit actif n’est actuellement
                disponible dans cette catégorie.
              </p>
            {% elseif hasCatalogFilters %}
              <h3>
                Aucun produit ne correspond aux filtres
              </h3>

              <p class="muted">
                Modifiez ou réinitialisez les filtres
                pour élargir les résultats.
              </p>
            {% else %}
              <h3>
                Aucun produit disponible
              </h3>

              <p class="muted">
                Le catalogue ne contient actuellement
                aucun produit disponible.
              </p>
            {% endif %}

            {% if query
              or category
              or hasCatalogFilters
            %}
              <div class="catalog-empty-actions">
                {% if hasCatalogFilters %}
                  <a
                    class="btn"
                    data-empty-filter-reset
                    href="{{ path(
                      'app_home',
                      filterResetParams
                    ) }}"
                  >
                    <i
                      class="fa-solid fa-filter-circle-xmark"
                      aria-hidden="true"
                    ></i>

                    Réinitialiser les filtres
                  </a>
                {% endif %}
                {% if query %}
                  <a
                    class="btn"
                    data-empty-search-reset
                    href="{{ path(
                      'app_home',
                      category
                        ? {category: category}
                        : {}
                    ) }}"
                  >
                    <i
                      class="fa-solid fa-xmark"
                      aria-hidden="true"
                    ></i>

                    Effacer la recherche
                  </a>
                {% endif %}

                {% if category %}
                  <a
                    class="btn orange"
                    data-empty-catalog-reset
                    href="{{ path('app_home') }}"
                  >
                    <i
                      class="fa-solid fa-table-cells-large"
                      aria-hidden="true"
                    ></i>

                    Voir tous les produits
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {% if latestArticles is not empty %}
    <section
      class="section home-editorial-section"
      aria-labelledby="home-editorial-title"
    >
      <div class="container">
        <header class="home-section-heading">
          <div>
            <p class="catalog-heading-eyebrow">
              Journal Shopwho
            </p>

            <h2 id="home-editorial-title">
              Derniers articles
            </h2>

            <p class="muted">
              Analyses, coulisses et contenus autour
              du e-commerce, de l’expérience utilisateur
              et de la donnée.
            </p>
          </div>

          <a
            class="home-section-link"
            href="{{ path('app_article_index') }}"
          >
            Tous les articles

            <i
              class="fa-solid fa-arrow-right"
              aria-hidden="true"
            ></i>
          </a>
        </header>

        <div class="home-editorial-grid">
          {% for article in latestArticles %}
            <article class="home-editorial-card">
              <a
                class="home-editorial-card-link"
                href="{{ path(
                  'app_article_show',
                  {
                    slug: article.slug
                  }
                ) }}"
              >
                {% if article.coverImageUrl %}
                  <img
                    class="home-editorial-card-image"
                    src="{{ article.coverImageUrl }}"
                    alt="{{ article.title }}"
                  >
                {% else %}
                  <div
                    class="home-editorial-card-placeholder"
                    aria-hidden="true"
                  >
                    <i class="fa-solid fa-newspaper"></i>
                  </div>
                {% endif %}

                <div class="home-editorial-card-body">
                  <time
                    datetime="{{ (
                      article.publishedAt
                        ?? article.createdAt
                    )|date('c') }}"
                  >
                    {{ (
                      article.publishedAt
                        ?? article.createdAt
                    )|date('d/m/Y') }}
                  </time>

                  <h3>
                    {{ article.title }}
                  </h3>

                  <p>
                    {{ article.excerpt|slice(0, 140) }}
                    {%- if article.excerpt|length > 140 -%}
                      …
                    {%- endif -%}
                  </p>

                  <span class="home-editorial-card-cta">
                    Lire l’article

                    <i
                      class="fa-solid fa-arrow-right"
                      aria-hidden="true"
                    ></i>
                  </span>
                </div>
              </a>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if featuredPartners is not empty %}
    <section
      class="section home-partners-section"
      aria-labelledby="home-partners-title"
    >
      <div class="container">
        <header class="home-section-heading">
          <div>
            <p class="catalog-heading-eyebrow">
              Écosystème Shopwho
            </p>

            <h2 id="home-partners-title">
              Nos partenaires
            </h2>

            <p class="muted">
              Les organisations et projets qui
              participent à l’écosystème Shopwho.
            </p>
          </div>

          <a
            class="home-section-link"
            href="{{ path('app_partner_index') }}"
          >
            Tous les partenaires

            <i
              class="fa-solid fa-arrow-right"
              aria-hidden="true"
            ></i>
          </a>
        </header>

        <div class="home-partners-grid">
          {% for partner in featuredPartners %}
            <a
              class="home-partner-card"
              href="{{ partner.websiteUrl }}"
              target="_blank"
              rel="noopener noreferrer external"
            >
              <div class="home-partner-logo">
                {% if partner.logoUrl %}
                  <img
                    src="{{ partner.logoUrl }}"
                    alt="Logo {{ partner.name }}"
                  >
                {% else %}
                  <i
                    class="fa-solid fa-handshake"
                    aria-hidden="true"
                  ></i>
                {% endif %}
              </div>

              <strong>
                {{ partner.name }}
              </strong>
            </a>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}
{% endblock %}

{% block javascripts %}
  {% if catalogTrackingEnabled %}
    <script
      src="/js/catalog-tracking.js"
      defer
    ></script>

    {% if recommendations is not empty %}
      <script
        src="/js/recommendation-tracking.js"
        defer
      ></script>
    {% endif %}
  {% endif %}
{% endblock %}
