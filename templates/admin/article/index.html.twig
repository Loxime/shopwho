{% extends 'admin/base.html.twig' %}

{% block admin_title %}
Articles
{% endblock %}

{% block admin_subtitle %}
Contenus éditoriaux du storefront
{% endblock %}

{% block admin_actions %}
<a
  class="admin-button admin-button-primary"
  href="{{ path('admin_article_new') }}"
>
  <i
    class="fa-solid fa-plus"
    aria-hidden="true"
  ></i>

  Nouvel article
</a>
{% endblock %}

{% block admin_body %}
<section
  class="admin-card"
  aria-labelledby="articles-title"
>
  <div class="admin-card-header">
    <div>
      <h2 id="articles-title">
        Articles configurés
      </h2>

      <p>
        {{ articles|length }}
        article{{ articles|length > 1 ? 's' : '' }}
      </p>
    </div>
  </div>

  <div class="admin-table-scroll">
    <table class="admin-table">
      <thead>
        <tr>
          <th scope="col">Article</th>
          <th scope="col">Publication</th>
          <th scope="col">Statut</th>
          <th
            scope="col"
            class="admin-table-actions-heading"
          >
            Actions
          </th>
        </tr>
      </thead>

      <tbody>
        {% for article in articles %}
          <tr>
            <td>
              <strong>
                {{ article.title }}
              </strong>

              <div class="muted">
                /articles/{{ article.slug }}
              </div>
            </td>

            <td>
              {% if article.publishedAt %}
                {{ article.publishedAt
                  |date('d/m/Y H:i')
                }}
              {% else %}
                Non planifiée
              {% endif %}
            </td>

            <td>
              {% if article.visibleAt %}
                <span
                  class="
                    admin-badge
                    admin-badge-success
                  "
                >
                  Publié
                </span>
              {% elseif article.published %}
                <span
                  class="
                    admin-badge
                    admin-badge-accent
                  "
                >
                  Planifié
                </span>
              {% else %}
                <span
                  class="
                    admin-badge
                    admin-badge-muted
                  "
                >
                  Brouillon
                </span>
              {% endif %}
            </td>

            <td>
              <div class="admin-row-actions">
                <a
                  class="admin-icon-button"
                  href="{{ path(
                    'admin_article_edit',
                    {
                      id: article.id
                    }
                  ) }}"
                  title="Modifier {{ article.title }}"
                  aria-label="Modifier {{ article.title }}"
                >
                  <i
                    class="fa-solid fa-pen-to-square"
                    aria-hidden="true"
                  ></i>
                </a>

                <form
                  method="post"
                  action="{{ path(
                    'admin_article_toggle',
                    {
                      id: article.id
                    }
                  ) }}"
                >
                  <input
                    type="hidden"
                    name="_token"
                    value="{{ csrf_token(
                      'toggle-article-' ~ article.id
                    ) }}"
                  >

                  <button
                    class="admin-icon-button"
                    type="submit"
                    title="{{ article.published
                      ? 'Dépublier'
                      : 'Publier'
                    }} {{ article.title }}"
                    aria-label="{{ article.published
                      ? 'Dépublier'
                      : 'Publier'
                    }} {{ article.title }}"
                  >
                    <i
                      class="fa-solid {{ article.published
                        ? 'fa-toggle-on'
                        : 'fa-toggle-off'
                      }}"
                      aria-hidden="true"
                    ></i>
                  </button>
                </form>

                <form
                  method="post"
                  action="{{ path(
                    'admin_article_delete',
                    {
                      id: article.id
                    }
                  ) }}"
                  onsubmit="
                    return confirm(
                      'Supprimer cet article ?'
                    )
                  "
                >
                  <input
                    type="hidden"
                    name="_token"
                    value="{{ csrf_token(
                      'delete-article-' ~ article.id
                    ) }}"
                  >

                  <button
                    class="
                      admin-icon-button
                      admin-icon-button-danger
                    "
                    type="submit"
                    title="Supprimer {{ article.title }}"
                    aria-label="Supprimer {{ article.title }}"
                  >
                    <i
                      class="fa-solid fa-trash"
                      aria-hidden="true"
                    ></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        {% else %}
          <tr>
            <td
              colspan="4"
              class="admin-empty-state"
            >
              Aucun article configuré.
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
