{% extends 'admin/base.html.twig' %}

{% block admin_title %}
{{ title }}
{% endblock %}

{% block admin_subtitle %}
Gestion du contenu éditorial
{% endblock %}

{% block admin_body %}
<section class="admin-card">
  {{ form_start(form) }}

  {{ form_row(form.title) }}
  {{ form_row(form.slug) }}
  {{ form_row(form.excerpt) }}
  {{ form_row(form.content) }}
  {{ form_row(form.coverImageUrl) }}
  {{ form_row(form.isPublished) }}
  {{ form_row(form.publishedAt) }}

  <div class="admin-form-actions">
    <button
      class="
        admin-button
        admin-button-primary
      "
      type="submit"
    >
      <i
        class="fa-solid fa-floppy-disk"
        aria-hidden="true"
      ></i>

      Enregistrer
    </button>

    <a
      class="admin-button"
      href="{{ path('admin_article_index') }}"
    >
      Annuler
    </a>
  </div>

  {{ form_end(form) }}
</section>
{% endblock %}
