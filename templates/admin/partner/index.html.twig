{% extends 'admin/base.html.twig' %}

{% block admin_title %}
Partenaires
{% endblock %}

{% block admin_subtitle %}
Organisations affichées sur le storefront
{% endblock %}

{% block admin_actions %}
<a
  class="admin-button admin-button-primary"
  href="{{ path('admin_partner_new') }}"
>
  <i
    class="fa-solid fa-plus"
    aria-hidden="true"
  ></i>

  Nouveau partenaire
</a>
{% endblock %}

{% block admin_body %}
<section class="admin-card">
  <div class="admin-table-scroll">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Partenaire</th>
          <th>Site</th>
          <th>Priorité</th>
          <th>Statut</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
        {% for partner in partners %}
          <tr>
            <td>
              <strong>
                {{ partner.name }}
              </strong>

              {% if partner.description %}
                <div class="muted">
                  {{ partner.description|slice(0, 100) }}
                </div>
              {% endif %}
            </td>

            <td>
              <a
                href="{{ partner.websiteUrl }}"
                target="_blank"
                rel="noopener noreferrer"
              >
                {{ partner.websiteUrl }}
              </a>
            </td>

            <td>
              {{ partner.priority }}
            </td>

            <td>
              <span
                class="admin-badge {{ partner.active
                  ? 'admin-badge-success'
                  : 'admin-badge-muted'
                }}"
              >
                {{ partner.active
                  ? 'Actif'
                  : 'Inactif'
                }}
              </span>
            </td>

            <td>
              <div class="admin-row-actions">
                <a
                  class="admin-icon-button"
                  href="{{ path(
                    'admin_partner_edit',
                    {
                      id: partner.id
                    }
                  ) }}"
                  aria-label="Modifier {{ partner.name }}"
                >
                  <i
                    class="fa-solid fa-pen"
                    aria-hidden="true"
                  ></i>
                </a>

                <form
                  method="post"
                  action="{{ path(
                    'admin_partner_toggle',
                    {
                      id: partner.id
                    }
                  ) }}"
                >
                  <input
                    type="hidden"
                    name="_token"
                    value="{{ csrf_token(
                      'toggle-partner-' ~ partner.id
                    ) }}"
                  >

                  <button
                    class="admin-icon-button"
                    type="submit"
                    aria-label="Activer ou désactiver {{ partner.name }}"
                  >
                    <i
                      class="fa-solid {{ partner.active
                        ? 'fa-toggle-on'
                        : 'fa-toggle-off'
                      }}"
                      aria-hidden="true"
                    ></i>
                  </button>
                </form>

                <form
                  method="post"
                  action="{{ path(
                    'admin_partner_delete',
                    {
                      id: partner.id
                    }
                  ) }}"
                  onsubmit="return confirm(
                    'Supprimer ce partenaire ?'
                  )"
                >
                  <input
                    type="hidden"
                    name="_token"
                    value="{{ csrf_token(
                      'delete-partner-' ~ partner.id
                    ) }}"
                  >

                  <button
                    class="
                      admin-icon-button
                      admin-icon-button-danger
                    "
                    type="submit"
                    aria-label="Supprimer {{ partner.name }}"
                  >
                    <i
                      class="fa-solid fa-trash"
                      aria-hidden="true"
                    ></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        {% else %}
          <tr>
            <td
              colspan="5"
              class="admin-empty-state"
            >
              Aucun partenaire.
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
