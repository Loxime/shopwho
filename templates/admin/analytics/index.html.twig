{% extends 'admin/base.html.twig' %}

{% block admin_title %}
  Analytics
{% endblock %}

{% block admin_subtitle %}
  Analyse des sessions ayant accepté
  le suivi comportemental.
{% endblock %}

{% block admin_actions %}
  <form
    class="admin-analytics-period"
    method="get"
    action="{{ path(
      'admin_analytics_index'
    ) }}"
  >
    <label for="analytics-period">
      Période
    </label>

    <select
      id="analytics-period"
      name="days"
      onchange="this.form.submit()"
    >
      {% for period in periods %}
        <option
          value="{{ period }}"
          {{ period == days
            ? 'selected'
            : ''
          }}
        >
          {{ period }} jours
        </option>
      {% endfor %}
    </select>

    <noscript>
      <button
        class="admin-button admin-button-secondary"
        type="submit"
      >
        Appliquer
      </button>
    </noscript>
  </form>
{% endblock %}

{% block admin_body %}
  <div class="admin-analytics">
    <div class="admin-callout admin-callout-info">
      <i
        class="fa-solid fa-circle-info"
        aria-hidden="true"
      ></i>

      <div>
        <strong>
          Données issues du tracking consenti
        </strong>

        <p>
          Ces statistiques représentent uniquement
          les visiteurs et sessions pour lesquels
          le suivi comportemental est actif.
          Elles ne correspondent donc pas au trafic
          total du site.
        </p>
      </div>
    </div>

    <section
      class="admin-analytics-kpis"
      aria-label="Indicateurs principaux"
    >
      <article class="admin-kpi-card">
        <div class="admin-kpi-icon">
          <i
            class="fa-solid fa-arrow-pointer"
            aria-hidden="true"
          ></i>
        </div>

        <div>
          <span class="admin-kpi-label">
            Événements
          </span>

          <strong class="admin-kpi-value">
            {{ overview.totalEvents|number_format(
              0,
              ',',
              ' '
            ) }}
          </strong>
        </div>
      </article>

      <article class="admin-kpi-card">
        <div class="admin-kpi-icon">
          <i
            class="fa-solid fa-users"
            aria-hidden="true"
          ></i>
        </div>

        <div>
          <span class="admin-kpi-label">
            Visiteurs trackés
          </span>

          <strong class="admin-kpi-value">
            {{ overview.uniqueVisitors|number_format(
              0,
              ',',
              ' '
            ) }}
          </strong>
        </div>
      </article>

      <article class="admin-kpi-card">
        <div class="admin-kpi-icon">
          <i
            class="fa-solid fa-window-restore"
            aria-hidden="true"
          ></i>
        </div>

        <div>
          <span class="admin-kpi-label">
            Sessions trackées
          </span>

          <strong class="admin-kpi-value">
            {{ overview.uniqueSessions|number_format(
              0,
              ',',
              ' '
            ) }}
          </strong>
        </div>
      </article>

      <article class="admin-kpi-card">
        <div class="admin-kpi-icon">
          <i
            class="fa-solid fa-user-check"
            aria-hidden="true"
          ></i>
        </div>

        <div>
          <span class="admin-kpi-label">
            Utilisateurs identifiés
          </span>

          <strong class="admin-kpi-value">
            {{ overview.identifiedUsers|number_format(
              0,
              ',',
              ' '
            ) }}
          </strong>
        </div>
      </article>

      <article class="admin-kpi-card">
        <div class="admin-kpi-icon">
          <i
            class="fa-solid fa-eye"
            aria-hidden="true"
          ></i>
        </div>

        <div>
          <span class="admin-kpi-label">
            Vues produit
          </span>

          <strong class="admin-kpi-value">
            {{ overview.productViews|number_format(
              0,
              ',',
              ' '
            ) }}
          </strong>
        </div>
      </article>

      <article class="admin-kpi-card">
        <div class="admin-kpi-icon">
          <i
            class="fa-solid fa-cart-plus"
            aria-hidden="true"
          ></i>
        </div>

        <div>
          <span class="admin-kpi-label">
            Ajouts panier
          </span>

          <strong class="admin-kpi-value">
            {{ overview.cartAdds|number_format(
              0,
              ',',
              ' '
            ) }}
          </strong>
        </div>
      </article>

      <article class="admin-kpi-card">
        <div class="admin-kpi-icon">
          <i
            class="fa-solid fa-credit-card"
            aria-hidden="true"
          ></i>
        </div>

        <div>
          <span class="admin-kpi-label">
            Checkouts
          </span>

          <strong class="admin-kpi-value">
            {{ overview.checkoutStarts|number_format(
              0,
              ',',
              ' '
            ) }}
          </strong>
        </div>
      </article>

      <article class="admin-kpi-card">
        <div class="admin-kpi-icon">
          <i
            class="fa-solid fa-bag-shopping"
            aria-hidden="true"
          ></i>
        </div>

        <div>
          <span class="admin-kpi-label">
            Achats
          </span>

          <strong class="admin-kpi-value">
            {{ overview.purchases|number_format(
              0,
              ',',
              ' '
            ) }}
          </strong>
        </div>
      </article>
    </section>

    <section class="admin-card">
      <div class="admin-card-header">
        <div>
          <h2>
            Conversion des sessions trackées
          </h2>

          <p>
            Part des sessions trackées contenant
            un événement d'achat.
          </p>
        </div>

        <i
          class="fa-solid fa-chart-line"
          aria-hidden="true"
        ></i>
      </div>

      <div class="admin-analytics-conversion">
        <strong>
          {{ overview.trackedSessionConversionRate
            |number_format(
              2,
              ',',
              ' '
            )
          }} %
        </strong>

        <span>
          {{ overview.purchaseSessions }}
          session{{ overview.purchaseSessions > 1 ? 's' : '' }}
          avec achat pour
          {{ overview.uniqueSessions }}
          session{{ overview.uniqueSessions > 1 ? 's' : '' }}
          trackée{{ overview.uniqueSessions > 1 ? 's' : '' }}.
        </span>
      </div>
    </section>

    <section
      class="admin-card admin-interaction-analytics"
    >
      <div class="admin-card-header">
        <div>
          <h2>
            Taux de clic des expositions
          </h2>

          <p>
            Rapport entre les éléments affichés
            et les interactions enregistrées.
          </p>
        </div>

        <i
          class="fa-solid fa-arrow-pointer"
          aria-hidden="true"
        ></i>
      </div>

      <dl class="admin-analytics-engagement">
        <div>
          <dt>
            Cartes produits
          </dt>

          <dd>
            {{ interactions.productCtr
              |number_format(2, ',', ' ')
            }} %
          </dd>

          <small>
            {{ interactions.productClicks }}
            clic{{ interactions.productClicks > 1 ? 's' : '' }}
            /
            {{ interactions.productImpressions }}
            impression{{ interactions.productImpressions > 1 ? 's' : '' }}
          </small>
        </div>

        <div>
          <dt>
            Recommandations
          </dt>

          <dd>
            {{ interactions.recommendationCtr
              |number_format(2, ',', ' ')
            }} %
          </dd>

          <small>
            {{ interactions.recommendationClicks }}
            clic{{ interactions.recommendationClicks > 1 ? 's' : '' }}
            /
            {{ interactions.recommendationImpressions }}
            impression{{ interactions.recommendationImpressions > 1 ? 's' : '' }}
          </small>
        </div>

        <div>
          <dt>
            Offres spéciales
          </dt>

          <dd>
            {{ interactions.specialOfferCtr
              |number_format(2, ',', ' ')
            }} %
          </dd>

          <small>
            {{ interactions.specialOfferClicks }}
            clic{{ interactions.specialOfferClicks > 1 ? 's' : '' }}
            /
            {{ interactions.specialOfferImpressions }}
            impression{{ interactions.specialOfferImpressions > 1 ? 's' : '' }}
          </small>
        </div>
      </dl>
    </section>

    <section class="admin-card">
      <div class="admin-card-header">
        <div>
          <h2>
            Funnel comportemental
          </h2>

          <p>
            Sessions ayant progressé dans
            l'ordre vue produit → panier →
            checkout → achat.
          </p>
        </div>

        <i
          class="fa-solid fa-filter"
          aria-hidden="true"
        ></i>
      </div>

      <div class="admin-funnel">
        <div class="admin-funnel-step">
          <div class="admin-funnel-heading">
            <span>
              Vues produit
            </span>

            <strong>
              {{ funnel.productViewSessions }}
            </strong>
          </div>

          <div class="admin-funnel-track">
            <span style="--funnel-width:100%"></span>
          </div>

          <small>
            Base du funnel
          </small>
        </div>

        <div class="admin-funnel-step">
          <div class="admin-funnel-heading">
            <span>
              Ajout panier
            </span>

            <strong>
              {{ funnel.cartSessions }}
            </strong>
          </div>

          <div class="admin-funnel-track">
            <span
              style="--funnel-width:{{ funnel.viewToCartRate }}%"
            ></span>
          </div>

          <small>
            {{ funnel.viewToCartRate
              |number_format(2, ',', ' ')
            }} %
            depuis la vue produit
          </small>
        </div>

        <div class="admin-funnel-step">
          <div class="admin-funnel-heading">
            <span>
              Checkout
            </span>

            <strong>
              {{ funnel.checkoutSessions }}
            </strong>
          </div>

          <div class="admin-funnel-track">
            <span
              style="--funnel-width:{{ funnel.checkoutShareOfViews }}%"
            ></span>
          </div>

          <small>
            {{ funnel.cartToCheckoutRate
              |number_format(2, ',', ' ')
            }} %
            depuis le panier
          </small>
        </div>

        <div class="admin-funnel-step">
          <div class="admin-funnel-heading">
            <span>
              Achat
            </span>

            <strong>
              {{ funnel.purchaseSessions }}
            </strong>
          </div>

          <div class="admin-funnel-track">
            <span
              style="--funnel-width:{{ funnel.viewToPurchaseRate }}%"
            ></span>
          </div>

          <small>
            {{ funnel.checkoutToPurchaseRate
              |number_format(2, ',', ' ')
            }} %
            depuis le checkout
          </small>
        </div>
      </div>
    </section>


    <section class="admin-card">
      <div class="admin-card-header">
        <div>
          <h2>
            Produits les plus engagés
          </h2>

          <p>
            Classement basé sur les interactions
            comportementales trackées.
          </p>
        </div>

        <i
          class="fa-solid fa-ranking-star"
          aria-hidden="true"
        ></i>
      </div>

      <div class="admin-table-scroll">
        <table class="admin-table">
          <thead>
            <tr>
              <th>
                Produit
              </th>

              <th>
                Vues
              </th>

              <th>
                Ajouts panier
              </th>

              <th>
                Taux panier
              </th>

              <th>
                Favoris
              </th>

              <th>
                Clics recommandations
              </th>

              <th class="admin-table-actions-heading">
                Action
              </th>
            </tr>
          </thead>

          <tbody>
            {% for product in topProducts %}
              <tr>
                <td>
                  <strong>
                    {{ product.name }}
                  </strong>
                </td>

                <td>
                  {{ product.views }}
                </td>

                <td>
                  {{ product.cartAdds }}
                </td>

                <td>
                  {{ product.cartRate
                    |number_format(
                      2,
                      ',',
                      ' '
                    )
                  }} %
                </td>

                <td>
                  {{ product.favoriteAdds }}
                </td>

                <td>
                  {{ product.recommendationClicks }}
                </td>

                <td>
                  <div class="admin-row-actions">
                    <a
                      class="admin-icon-button"
                      href="{{ path(
                        'admin_product_edit',
                        {
                          id: product.id
                        }
                      ) }}"
                      title="Voir le produit"
                    >
                      <i
                        class="fa-solid fa-arrow-up-right-from-square"
                        aria-hidden="true"
                      ></i>
                    </a>
                  </div>
                </td>
              </tr>
            {% else %}
              <tr>
                <td
                  class="admin-empty-state"
                  colspan="7"
                >
                  Aucune interaction produit
                  sur cette période.
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <section class="admin-card">
      <div class="admin-card-header">
        <div>
          <h2>
            Engagement
          </h2>

          <p>
            Interactions comportementales
            complémentaires.
          </p>
        </div>

        <i
          class="fa-solid fa-heart-pulse"
          aria-hidden="true"
        ></i>
      </div>

      <dl class="admin-analytics-engagement">
        <div>
          <dt>
            Favoris ajoutés
          </dt>

          <dd>
            {{ overview.favoriteAdds }}
          </dd>
        </div>

        <div>
          <dt>
            Clics recommandations
          </dt>

          <dd>
            {{ overview.recommendationClicks }}
          </dd>
        </div>

        <div>
          <dt>
            Clics offres spéciales
          </dt>

          <dd>
            {{ overview.specialOfferClicks }}
          </dd>
        </div>
      </dl>
    </section>

    <section
      class="admin-card admin-data-quality"
    >
      <div class="admin-card-header">
        <div>
          <h2>
            Qualité du dataset
          </h2>

          <p>
            Contrôles automatiques sur les événements
            collectés pendant la période.
          </p>
        </div>

        <i
          class="fa-solid fa-shield-halved"
          aria-hidden="true"
        ></i>
      </div>

      <dl class="admin-analytics-engagement">
        <div>
          <dt>
            Événements inconnus
          </dt>

          <dd>
            {{ dataQuality.unknownEventTypes }}
          </dd>
        </div>

        <div>
          <dt>
            Produits inexistants
          </dt>

          <dd>
            {{ dataQuality.missingProductReferences }}
          </dd>
        </div>

        <div>
          <dt>
            Produit manquant
          </dt>

          <dd>
            {{ dataQuality.missingRequiredProductIds }}
          </dd>
        </div>

        <div>
          <dt>
            Sessions multi-visiteurs
          </dt>

          <dd>
            {{ dataQuality.mixedVisitorSessions }}
          </dd>
        </div>

        <div>
          <dt>
            Métadonnées vides
          </dt>

          <dd>
            {{ dataQuality.emptyMetadataEvents }}
          </dd>
        </div>

        <div>
          <dt>
            Anomalies bloquantes
          </dt>

          <dd>
            {{ dataQuality.issueCount }}
          </dd>
        </div>
      </dl>
    </section>

    <section class="admin-card">
      <div class="admin-card-header">
        <div>
          <h2>
            Couverture du contrat d’événements
          </h2>

          <p>
            Présence de chaque événement canonique
            dans la période analysée.
          </p>
        </div>

        <i
          class="fa-solid fa-table-list"
          aria-hidden="true"
        ></i>
      </div>

      <div class="admin-table-scroll">
        <table class="admin-table">
          <thead>
            <tr>
              <th>
                Événement
              </th>

              <th>
                Occurrences
              </th>

              <th>
                Part des événements
              </th>
            </tr>
          </thead>

          <tbody>
            {% for coverage in eventCoverage %}
              <tr>
                <td>
                  <code>
                    {{ coverage.eventType }}
                  </code>
                </td>

                <td>
                  {{ coverage.count }}
                </td>

                <td>
                  {{ coverage.shareOfEvents
                    |number_format(2, ',', ' ')
                  }} %
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <section
    class="admin-card"
    aria-labelledby="recommendation-feedback-title"
  >
    <h2 id="recommendation-feedback-title">
      Feedback automatique des recommandations
    </h2>

    <p class="muted">
      Chaque ligne représente un parcours unique
      session × produit × stratégie. Le funnel exige
      l’ordre impression → clic → panier → achat.
    </p>

    <p class="muted">
      L’attribution produit des achats est disponible
      pour les commandes authentifiées disposant d’un
      identifiant de commande dans le tracking.
    </p>

    {% if recommendationFeedback is empty %}
      <p>
        Aucun parcours de recommandation exploitable
        sur cette période.
      </p>
    {% else %}
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Produit</th>
              <th>Stratégie</th>
              <th>Variante</th>
              <th>Expositions</th>
              <th>Clics</th>
              <th>CTR</th>
              <th>Paniers</th>
              <th>Clic → panier</th>
              <th>Achats</th>
              <th>Panier → achat</th>
              <th>Expo. → achat</th>
            </tr>
          </thead>

          <tbody>
            {% for feedback in recommendationFeedback %}
              <tr>
                <td>
                  {{ feedback.productName }}
                </td>

                <td>
                  {{ feedback.strategy }}
                </td>

                <td>
                  {{ feedback.experimentVariant
                    ?? '—'
                  }}
                </td>

                <td>
                  {{ feedback.exposedJourneys }}
                </td>

                <td>
                  {{ feedback.clickedJourneys }}
                </td>

                <td>
                  {{ feedback.ctr|number_format(
                    2,
                    ',',
                    ' '
                  ) }} %
                </td>

                <td>
                  {{ feedback.cartedJourneys }}
                </td>

                <td>
                  {{
                    feedback.clickToCartRate
                      |number_format(
                        2,
                        ',',
                        ' '
                      )
                  }} %
                </td>

                <td>
                  {{ feedback.purchasedJourneys }}
                </td>

                <td>
                  {{
                    feedback.cartToPurchaseRate
                      |number_format(
                        2,
                        ',',
                        ' '
                      )
                  }} %
                </td>

                <td>
                  {{
                    feedback.exposureToPurchaseRate
                      |number_format(
                        2,
                        ',',
                        ' '
                      )
                  }} %
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </section>

{% endblock %}
