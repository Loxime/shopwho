{% extends 'admin/base.html.twig' %}

{% block admin_title %}
  Expériences A/B
{% endblock %}

{% block admin_subtitle %}
  Configuration et suivi des expérimentations ShopWho
{% endblock %}

{% block admin_actions %}
  <a
    class="admin-button admin-button-primary"
    href="{{ path('admin_experiment_new') }}"
  >
    <i
      class="fa-solid fa-plus"
      aria-hidden="true"
    ></i>
    Nouvelle expérience
  </a>
{% endblock %}

{% block admin_body %}
  <section
    class="admin-card"
    aria-labelledby="experiments-title"
  >
    <div class="admin-card-header">
      <div>
        <h2 id="experiments-title">
          Expériences configurées
        </h2>

        <p>
          {{ experiments|length }}
          expérience{{ experiments|length > 1 ? 's' : '' }}
        </p>
      </div>
    </div>

    <div class="admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">Expérience</th>
            <th scope="col">Statut</th>
            <th scope="col">Trafic</th>
            <th scope="col">Variantes</th>
            <th scope="col">Période</th>
            <th scope="col">Mise à jour</th>

            <th
              scope="col"
              class="admin-table-actions-heading"
            >
              Actions
            </th>
          </tr>
        </thead>

        <tbody>
          {% for experiment in experiments %}
            <tr>
              <td>
                <strong>
                  {{ experiment.name }}
                </strong>

                <div class="muted">
                  {{ experiment.key }}
                </div>
              </td>

              <td>
                {% if experiment.status.value == 'running' %}
                  <span class="admin-badge admin-badge-success">
                    {{ experiment.status.label }}
                  </span>
                {% elseif experiment.status.value == 'paused' %}
                  <span class="admin-badge admin-badge-accent">
                    {{ experiment.status.label }}
                  </span>
                {% else %}
                  <span class="admin-badge admin-badge-muted">
                    {{ experiment.status.label }}
                  </span>
                {% endif %}
              </td>

              <td>
                {{ experiment.trafficPercentage }} %
              </td>

              <td>
                {% for variant in experiment.variants %}
                  <span class="admin-badge admin-badge-muted">
                    {{ variant.key }}
                    · {{ variant.weight }}
                  </span>
                {% else %}
                  <span class="muted">
                    Aucune variante
                  </span>
                {% endfor %}
              </td>

              <td>
                {% if experiment.startsAt %}
                  {{ experiment.startsAt|date('d/m/Y H:i', 'Europe/Paris') }}
                {% else %}
                  Immédiat
                {% endif %}

                <br>

                <span class="muted">
                  jusqu’au
                  {% if experiment.endsAt %}
                    {{ experiment.endsAt|date('d/m/Y H:i', 'Europe/Paris') }}
                  {% else %}
                    ∞
                  {% endif %}
                </span>
              </td>

              <td>
                {{ experiment.updatedAt|date('d/m/Y H:i', 'Europe/Paris') }}
              </td>

              <td>
                <div class="admin-row-actions">
                  {% if experiment.status.value == 'draft' %}
                    <a
                      class="admin-icon-button"
                      href="{{ path(
                        'admin_experiment_edit',
                        {
                          id: experiment.id
                        }
                      ) }}"
                      title="Modifier {{ experiment.name }}"
                      aria-label="Modifier {{ experiment.name }}"
                    >
                      <i
                        class="fa-solid fa-pen-to-square"
                        aria-hidden="true"
                      ></i>
                    </a>

                    <form
                      method="post"
                      action="{{ path(
                        'admin_experiment_start',
                        {
                          id: experiment.id
                        }
                      ) }}"
                    >
                      <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token(
                          'start-experiment-' ~ experiment.id
                        ) }}"
                      >

                      <button
                        class="admin-icon-button"
                        type="submit"
                        title="Démarrer {{ experiment.name }}"
                        aria-label="Démarrer {{ experiment.name }}"
                      >
                        <i
                          class="fa-solid fa-play"
                          aria-hidden="true"
                        ></i>
                      </button>
                    </form>

                    <form
                      method="post"
                      action="{{ path(
                        'admin_experiment_delete',
                        {
                          id: experiment.id
                        }
                      ) }}"
                    >
                      <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token(
                          'delete-experiment-' ~ experiment.id
                        ) }}"
                      >

                      <button
                        class="
                          admin-icon-button
                          admin-icon-button-danger
                        "
                        type="submit"
                        title="Supprimer {{ experiment.name }}"
                        aria-label="Supprimer {{ experiment.name }}"
                      >
                        <i
                          class="fa-solid fa-trash"
                          aria-hidden="true"
                        ></i>
                      </button>
                    </form>

                  {% elseif experiment.status.value == 'running' %}
                    <form
                      method="post"
                      action="{{ path(
                        'admin_experiment_pause',
                        {
                          id: experiment.id
                        }
                      ) }}"
                    >
                      <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token(
                          'pause-experiment-' ~ experiment.id
                        ) }}"
                      >

                      <button
                        class="admin-icon-button"
                        type="submit"
                        title="Mettre en pause"
                        aria-label="Mettre en pause {{ experiment.name }}"
                      >
                        <i
                          class="fa-solid fa-pause"
                          aria-hidden="true"
                        ></i>
                      </button>
                    </form>

                    <form
                      method="post"
                      action="{{ path(
                        'admin_experiment_end',
                        {
                          id: experiment.id
                        }
                      ) }}"
                    >
                      <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token(
                          'end-experiment-' ~ experiment.id
                        ) }}"
                      >

                      <button
                        class="
                          admin-icon-button
                          admin-icon-button-danger
                        "
                        type="submit"
                        title="Terminer"
                        aria-label="Terminer {{ experiment.name }}"
                      >
                        <i
                          class="fa-solid fa-flag-checkered"
                          aria-hidden="true"
                        ></i>
                      </button>
                    </form>

                  {% elseif experiment.status.value == 'paused' %}
                    <form
                      method="post"
                      action="{{ path(
                        'admin_experiment_resume',
                        {
                          id: experiment.id
                        }
                      ) }}"
                    >
                      <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token(
                          'resume-experiment-' ~ experiment.id
                        ) }}"
                      >

                      <button
                        class="admin-icon-button"
                        type="submit"
                        title="Reprendre"
                        aria-label="Reprendre {{ experiment.name }}"
                      >
                        <i
                          class="fa-solid fa-play"
                          aria-hidden="true"
                        ></i>
                      </button>
                    </form>

                    <form
                      method="post"
                      action="{{ path(
                        'admin_experiment_end',
                        {
                          id: experiment.id
                        }
                      ) }}"
                    >
                      <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token(
                          'end-experiment-' ~ experiment.id
                        ) }}"
                      >

                      <button
                        class="
                          admin-icon-button
                          admin-icon-button-danger
                        "
                        type="submit"
                        title="Terminer"
                        aria-label="Terminer {{ experiment.name }}"
                      >
                        <i
                          class="fa-solid fa-flag-checkered"
                          aria-hidden="true"
                        ></i>
                      </button>
                    </form>

                  {% else %}
                    <span class="admin-badge admin-badge-muted">
                      <i
                        class="fa-solid fa-lock"
                        aria-hidden="true"
                      ></i>
                      Terminée
                    </span>
                  {% endif %}
                </div>
              </td>
            </tr>
          {% else %}
            <tr>
              <td
                colspan="7"
                class="admin-empty-state"
              >
                Aucune expérience A/B configurée.
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
{% endblock %}
