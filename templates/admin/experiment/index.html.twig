{% extends 'admin/base.html.twig' %}

{% block admin_title %}
  Expériences A/B
{% endblock %}

{% block admin_subtitle %}
  Configuration et suivi des expérimentations ShopWho
{% endblock %}

{% block admin_body %}
  <section
    class="admin-card"
    aria-labelledby="experiments-title"
  >
    <div class="admin-card-header">
      <div>
        <h2 id="experiments-title">
          Expériences configurées
        </h2>

        <p>
          {{ experiments|length }}
          expérience{{ experiments|length > 1 ? 's' : '' }}
        </p>
      </div>
    </div>

    <div class="admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">
              Expérience
            </th>

            <th scope="col">
              Statut
            </th>

            <th scope="col">
              Trafic
            </th>

            <th scope="col">
              Variantes
            </th>

            <th scope="col">
              Période
            </th>

            <th scope="col">
              Mise à jour
            </th>
          </tr>
        </thead>

        <tbody>
          {% for experiment in experiments %}
            <tr>
              <td>
                <strong>
                  {{ experiment.name }}
                </strong>

                <div class="muted">
                  {{ experiment.key }}
                </div>
              </td>

              <td>
                {% if experiment.status.value == 'running' %}
                  <span class="admin-badge admin-badge-success">
                    {{ experiment.status.label }}
                  </span>
                {% elseif experiment.status.value == 'paused' %}
                  <span class="admin-badge admin-badge-accent">
                    {{ experiment.status.label }}
                  </span>
                {% else %}
                  <span class="admin-badge admin-badge-muted">
                    {{ experiment.status.label }}
                  </span>
                {% endif %}
              </td>

              <td>
                {{ experiment.trafficPercentage }} %
              </td>

              <td>
                {% for variant in experiment.variants %}
                  <span class="admin-badge admin-badge-muted">
                    {{ variant.key }}
                    · {{ variant.weight }}
                  </span>
                {% else %}
                  <span class="muted">
                    Aucune variante
                  </span>
                {% endfor %}
              </td>

              <td>
                {% if experiment.startsAt %}
                  {{ experiment.startsAt|date('d/m/Y H:i') }}
                {% else %}
                  —
                {% endif %}

                <br>

                <span class="muted">
                  jusqu’au

                  {% if experiment.endsAt %}
                    {{ experiment.endsAt|date('d/m/Y H:i') }}
                  {% else %}
                    ∞
                  {% endif %}
                </span>
              </td>

              <td>
                {{ experiment.updatedAt|date('d/m/Y H:i') }}
              </td>
            </tr>
          {% else %}
            <tr>
              <td
                colspan="6"
                class="admin-empty-state"
              >
                Aucune expérience A/B configurée.
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
{% endblock %}
