{% extends 'admin/base.html.twig' %}
{% block admin_title %}Produits{% endblock %}
{% block admin_subtitle %}Gestion du catalogue Shopwho{% endblock %}
{% block admin_actions %}<a class="admin-button admin-button-primary" href="{{ path('admin_product_new') }}"><i class="fa-solid fa-plus" aria-hidden="true"></i> Nouveau produit</a>{% endblock %}
{% block admin_body %}
<section class="admin-card" aria-labelledby="products-list-title">
  <div class="admin-card-header"><div><h2 id="products-list-title">Catalogue</h2><p>{{ products|length }} produit{{ products|length > 1 ? 's' : '' }}</p></div></div>
  <div class="admin-table-scroll"><table class="admin-table">
    <thead><tr><th scope="col">Nom</th><th scope="col">Catégorie</th><th scope="col">Prix</th><th scope="col">Stock</th><th scope="col">Statut</th><th scope="col" class="admin-table-actions-heading">Actions</th></tr></thead><tbody>
    {% for product in products %}<tr><td><strong>{{ product.name }}</strong></td><td>{{ product.category.name }}</td><td class="admin-table-nowrap">{{ product.price|number_format(2, ',', ' ') }} €</td><td>{{ product.stock }}</td><td><span class="admin-badge {{ product.active ? 'admin-badge-success' : 'admin-badge-muted' }}"><span class="admin-badge-dot" aria-hidden="true"></span>{{ product.active ? 'Actif' : 'Inactif' }}</span></td><td><div class="admin-row-actions"><a class="admin-icon-button" href="{{ path('admin_product_edit', {id:product.id}) }}" title="Modifier {{ product.name }}" aria-label="Modifier {{ product.name }}"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i><span class="admin-sr-only">Modifier</span></a><form method="post" action="{{ path('admin_product_delete', {id:product.id}) }}" onsubmit="return confirm('Supprimer ce produit ?')"><input type="hidden" name="_token" value="{{ csrf_token('delete-product-' ~ product.id) }}"><button class="admin-icon-button admin-icon-button-danger" type="submit" title="Supprimer {{ product.name }}" aria-label="Supprimer {{ product.name }}"><i class="fa-solid fa-trash" aria-hidden="true"></i><span class="admin-sr-only">Supprimer</span></button></form></div></td></tr>{% else %}<tr><td class="admin-empty-state" colspan="6">Aucun produit dans le catalogue.</td></tr>{% endfor %}
    </tbody>
  </table></div>
</section>
{% endblock %}
