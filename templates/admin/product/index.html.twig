{% extends 'base.html.twig' %}
{% block title %}Administration produits — Shopwho{% endblock %}
{% block body %}
<section class="section"><div class="container">
  <div class="actions" style="justify-content:space-between"><div><p class="muted">Administration locale</p><h1>Produits</h1></div><a class="btn orange" href="{{ path('admin_product_new') }}">Nouveau produit</a></div>
  {% for message in app.flashes('success') %}<div class="flash">{{ message }}</div>{% endfor %}
  <table class="table"><thead><tr><th>Nom</th><th>Catégorie</th><th>Prix</th><th>Stock</th><th>Actif</th><th>Actions</th></tr></thead><tbody>
  {% for product in products %}<tr><td>{{ product.name }}</td><td>{{ product.category }}</td><td>{{ product.price|number_format(2, ',', ' ') }} €</td><td>{{ product.stock }}</td><td>{{ product.active ? 'Oui' : 'Non' }}</td><td><div class="actions"><a href="{{ path('admin_product_edit', {id:product.id}) }}">Modifier</a><form method="post" action="{{ path('admin_product_delete', {id:product.id}) }}" onsubmit="return confirm('Supprimer ce produit ?')"><input type="hidden" name="_token" value="{{ csrf_token('delete-product-' ~ product.id) }}"><button type="submit">Supprimer</button></form></div></td></tr>{% else %}<tr><td colspan="6">Aucun produit.</td></tr>{% endfor %}
  </tbody></table>
</div></section>
{% endblock %}
