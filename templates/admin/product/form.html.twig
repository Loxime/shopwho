{% extends 'admin/base.html.twig' %}
{% block admin_title %}{{ title }}{% endblock %}
{% block admin_subtitle %}Gestion du catalogue Shopwho{% endblock %}
{% block admin_body %}<div class="admin-form-page"><a class="admin-back-link" href="{{ path('admin_product_index') }}"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour aux produits</a><section class="admin-card admin-form-card"><div class="admin-card-header"><div><h2>Informations du produit</h2><p>Renseignez les informations utilisées dans le catalogue.</p></div></div>{{ form_start(form, {attr: {class: 'admin-form'}}) }}<div class="admin-form-fields">{% for field in form %}<div class="admin-form-row">{{ form_label(field) }}{{ form_widget(field) }}{{ form_errors(field) }}{% if field.vars.help %}<small class="admin-field-help">{{ field.vars.help }}</small>{% endif %}</div>{% endfor %}</div><div class="admin-form-actions"><a class="admin-button admin-button-secondary" href="{{ path('admin_product_index') }}">Annuler</a><button class="admin-button admin-button-primary" type="submit"><i class="fa-solid fa-check" aria-hidden="true"></i> Enregistrer</button></div>{{ form_end(form) }}</section></div>{% endblock %}
