{% extends 'base.html.twig' %}
{% block title %}Mes avis — Shopwho{% endblock %}
{% block body %}<section class="section"><div class="container"><h1>Mes avis</h1>
{% for message in app.flashes('success') %}<div class="flash">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="flash flash-error">{{ message }}</div>{% endfor %}
<div class="review-list">{% for review in reviews %}<article class="review-card" data-review-id="{{ review.id }}"><h2><a href="{{ path('app_product_show', {slug:review.product.slug}) }}">{{ review.product.name }}</a></h2><p><span class="stars" aria-hidden="true">{% for star in 1..5 %}{{ star <= review.rating ? '★' : '☆' }}{% endfor %}</span> {{ review.rating }}/5</p>{% if review.comment %}<p>{{ review.comment }}</p>{% endif %}<p class="muted">Publié le {{ review.createdAt|date('d/m/Y') }}</p><div class="actions"><a class="btn" href="{{ path('app_profile_review_edit', {id:review.id}) }}">Modifier</a><form method="post" action="{{ path('app_profile_review_delete', {id:review.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete-review-' ~ review.id) }}"><button class="icon-action danger" type="submit" aria-label="Supprimer l’avis sur {{ review.product.name }}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></form></div></article>{% else %}<p class="muted">Vous n’avez pas encore publié d’avis.</p>{% endfor %}</div>
</div></section>{% endblock %}
