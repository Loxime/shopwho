{% extends 'base.html.twig' %}

{% block title %}Panier — Shopwho{% endblock %}

{% block body %}
<section class="section">
  <div
    class="container cart-page"
    style="max-width:900px"
  >
    <h1>Votre panier</h1>

    {% for message in app.flashes('success') %}
      <div class="flash">
        {{ message }}
      </div>
    {% endfor %}

    {% if lines %}
      <table class="table cart-table">
        <thead>
          <tr>
            <th>Produit</th>
            <th>Quantité</th>
            <th>Total</th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          {% for line in lines %}
            <tr>
              <td>
                <a
                  class="cart-product"
                  href="{{ path(
                    'app_product_show',
                    {slug: line.product.slug}
                  ) }}"
                >
                  <span class="cart-product-media">
                    {% if line.product.imageUrl %}
                      <img
                        class="cart-product-thumbnail"
                        src="{{ line.product.imageUrl }}"
                        alt="{{ line.product.name }}"
                        loading="lazy"
                      >
                    {% else %}
                      <span
                        class="cart-product-thumbnail-placeholder"
                        aria-hidden="true"
                      >
                        <i class="fa-solid fa-image"></i>
                      </span>
                    {% endif %}
                  </span>

                  <span class="cart-product-name">
                    {{ line.product.name }}
                  </span>
                </a>
              </td>

              <td>
                <div
                  class="cart-quantity-controls"
                  data-cart-quantity-controls
                >
                  <form
                    method="post"
                    action="{{ path(
                      'app_cart_update_quantity',
                      {id: line.product.id}
                    ) }}"
                  >
                    <input
                      type="hidden"
                      name="quantity"
                      value="{{ line.quantity - 1 }}"
                    >

                    <button
                      class="cart-quantity-button"
                      type="submit"
                      aria-label="Diminuer la quantité de {{ line.product.name }}"
                      title="Diminuer la quantité"
                    >
                      <i
                        class="fa-solid fa-minus"
                        aria-hidden="true"
                      ></i>
                    </button>
                  </form>

                  <form
                    class="cart-quantity-form"
                    method="post"
                    action="{{ path(
                      'app_cart_update_quantity',
                      {id: line.product.id}
                    ) }}"
                  >
                    <label
                      class="sr-only"
                      for="cart-quantity-{{ line.product.id }}"
                    >
                      Quantité pour {{ line.product.name }}
                    </label>

                    <input
                      id="cart-quantity-{{ line.product.id }}"
                      class="cart-quantity-input"
                      type="number"
                      name="quantity"
                      value="{{ line.quantity }}"
                      min="0"
                      max="{{ line.product.stock }}"
                      step="1"
                      inputmode="numeric"
                    >

                    <button
                      class="cart-quantity-update"
                      type="submit"
                    >
                      Mettre à jour
                    </button>
                  </form>

                  <form
                    method="post"
                    action="{{ path(
                      'app_cart_update_quantity',
                      {id: line.product.id}
                    ) }}"
                  >
                    <input
                      type="hidden"
                      name="quantity"
                      value="{{ line.quantity + 1 }}"
                    >

                    <button
                      class="cart-quantity-button"
                      type="submit"
                      aria-label="Augmenter la quantité de {{ line.product.name }}"
                      title="Augmenter la quantité"
                      {% if line.quantity >= line.product.stock %}
                        disabled
                      {% endif %}
                    >
                      <i
                        class="fa-solid fa-plus"
                        aria-hidden="true"
                      ></i>
                    </button>
                  </form>
                </div>

                <small class="muted cart-stock">
                  Stock disponible :
                  {{ line.product.stock }}
                </small>
              </td>

              <td>
                {{ line.lineTotal|number_format(2, ',', ' ') }} €
              </td>

              <td>
                <form
                  method="post"
                  action="{{ path(
                    'app_cart_remove',
                    {id: line.product.id}
                  ) }}"
                >
                  <button type="submit">
                    Retirer
                  </button>
                </form>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <div class="cart-navigation">
        <a
          class="btn cart-continue-shopping"
          href="{{ path('app_home') }}"
        >
          <i
            class="fa-solid fa-arrow-left"
            aria-hidden="true"
          ></i>

          Continuer mes achats
        </a>
      </div>

      <div class="cart-summary">
        <strong class="price">
          {{ total|number_format(2, ',', ' ') }} €
        </strong>

        <form
          method="post"
          action="{{ path('app_cart_checkout') }}"
        >
          <input
            type="hidden"
            name="_token"
            value="{{ csrf_token('checkout') }}"
          >

          <button
            class="btn orange"
            type="submit"
          >
            Simuler la commande
          </button>
        </form>
      </div>

      <p class="muted">
        MVP : aucune transaction bancaire n'est réalisée.
      </p>
    {% else %}
      <p>
        Votre panier est vide.
      </p>

      <a
        class="btn"
        href="{{ path('app_home') }}"
      >
        Retour au catalogue
      </a>
    {% endif %}
  </div>
</section>
{% endblock %}
